{
  "projectId": "7c8aade7-758e-4cca-b966-97ba577775fa",
  "pkg": "@tachyon-sdk/native-ui",
  "globalName": "TachyonNativeUI",
  "shape": "package",
  "buildCmd": "./node_modules/.bin/tailwindcss -c .design-sync/tailwind.build.ts -i .design-sync/tailwind.input.css -o dist/native-ui.css",
  "tsconfig": "tsconfig.json",
  "cssEntry": "dist/native-ui.css",
  "guidelinesGlob": "docs/*.md",
  "readmeHeader": ".design-sync/conventions.md",
  "extraFonts": [".design-sync/fonts/inter/inter.css"],
  "provider": {
    "component": "TooltipProvider"
  },
  "overrides": {
    "Button": { "cardMode": "column" },
    "Badge": { "cardMode": "column" },
    "Dialog": { "cardMode": "single", "viewport": "640x480" },
    "DropdownMenu": { "cardMode": "single", "viewport": "480x420" },
    "Popover": { "cardMode": "single", "viewport": "480x360" },
    "Select": { "cardMode": "single", "viewport": "480x400" },
    "Sidebar": { "cardMode": "single", "viewport": "640x920" },
    "Tooltip": { "cardMode": "single", "viewport": "480x240" }

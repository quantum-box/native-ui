{
  "name": "@tachyon-sdk/native-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Native-app style UI component library (Linear/Notion-like density) built on shadcn/ui",
  "repository": {
    "type": "git",
    "url": "https://github.com/quantum-box/native-ui.git"
  },
  "packageManager": "yarn@4.4.1",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "lint": "biome lint ./src",
    "format": "biome format ./src",
    "format:write": "biome format --write ./src",
    "ts": "tsc --noEmit --incremental"
  },
  "peerDependencies": {
    "react": "18 - 19",
    "react-dom": "18 - 19"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.5",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.4",
    "lucide-react": "^0.474.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.1",
    "typescript": "~5.6.2"
  }
}

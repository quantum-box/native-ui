{
  "name": "@tachyon-sdk/native-ui",
  "version": "0.1.3",
  "private": true,
  "description": "Native-app style UI component library (Linear/Notion-like density) built on shadcn/ui",
  "repository": {
    "type": "git",
    "url": "https://github.com/quantum-box/native-ui.git"
  },
  "packageManager": "pnpm@11.12.0+sha512.820a6fbd0d9f04c226638002aead1e45340a9139dd5dc077c1d83ef44aa2481c8eb6637b4c9aa696a3c7e35ba818e49cf27213e5f2b91138d09b7a3e26e898ba",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./tailwind-preset": {
      "import": {
        "types": "./dist/tailwind-preset.d.mts",
        "default": "./dist/tailwind-preset.mjs"
      },
      "require": {
        "types": "./dist/tailwind-preset.d.ts",
        "default": "./dist/tailwind-preset.js"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.mts",
        "default": "./dist/testing.mjs"
      },
      "require": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      }
    },
    "./styles/tokens.css": "./src/styles/tokens.css",
    "./styles/theme.css": "./src/styles/theme.css",
    "./src/*": "./src/*"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "lint": "biome lint ./src",
    "format": "biome format ./src",
    "format:write": "biome format --write ./src",
    "ts": "tsc --noEmit --incremental",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:browser": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build": "storybook build",
    "build:lib": "tsup",
    "prepare": "tsup",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": "18 - 19",
    "react-dom": "18 - 19"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@hookform/resolvers": "^7.0.8",
    "@tanstack/react-table": "9.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.77.0",
    "react-hook-form": "^7.92.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6",
    "@playwright/test": "1.65.1",
    "@storybook/react-vite": "^10.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "autoprefixer": "^10.7.0",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.33",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.8",
    "tailwindcss": "^4.3.5",
    "tsup": "^9.0.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}

{
  "name": "@tachyon-sdk/native-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Native-app style UI component library (Linear/Notion-like density) built on shadcn/ui",
  "repository": {
    "type": "git",
    "url": "https://github.com/quantum-box/native-ui.git"
  },
  "packageManager": "pnpm@11.12.0+sha512.820a6fbd0d9f04c226638002aead1e45340a9139dd5dc077c1d83ef44aa2481c8eb6637b4c9aa696a3c7e35ba818e49cf27213e5f2b91138d09b7a3e26e898ba",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "lint": "biome lint ./src ./apps/client/src ./apps/client/vite.config.ts ./apps/client/tailwind.config.ts",
    "format": "biome format ./src ./apps/client/src ./apps/client/vite.config.ts ./apps/client/tailwind.config.ts ./apps/client/tsconfig.json ./apps/client/tsconfig.node.json && pnpm format:rust",
    "format:write": "biome format --write ./src ./apps/client/src ./apps/client/vite.config.ts ./apps/client/tailwind.config.ts ./apps/client/tsconfig.json ./apps/client/tsconfig.node.json && cargo fmt --manifest-path apps/client/src-tauri/Cargo.toml",
    "format:rust": "cargo fmt --manifest-path apps/client/src-tauri/Cargo.toml -- --check",
    "ts": "pnpm ts:library && pnpm ts:client",
    "ts:library": "tsc --noEmit --incremental",
    "ts:client": "pnpm --filter @tachyon-sdk/native-client ts",
    "dev:web": "pnpm --filter @tachyon-sdk/native-client dev",
    "build:web": "pnpm --filter @tachyon-sdk/native-client build",
    "preview:web": "pnpm --filter @tachyon-sdk/native-client preview",
    "dev:desktop": "pnpm --dir apps/client tauri dev",
    "build:desktop": "pnpm --dir apps/client tauri build",
    "init:android": "pnpm --dir apps/client tauri android init --ci",
    "dev:android": "pnpm --dir apps/client tauri android dev",
    "build:android": "pnpm --dir apps/client tauri android build",
    "init:ios": "pnpm --dir apps/client tauri ios init --ci",
    "dev:ios": "pnpm --dir apps/client tauri ios dev",
    "build:ios": "pnpm --dir apps/client tauri ios build",
    "storybook": "storybook dev -p 6006",
    "build": "storybook build",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": "18 - 19",
    "react-dom": "18 - 19"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.5",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.4",
    "lucide-react": "^0.474.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9",
    "@storybook/react-vite": "^9.1.20",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.2",
    "postcss": "^8.5.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^9.1.20",
    "tailwindcss": "^3.4.1",
    "typescript": "~5.6.2",
    "vite": "^7.3.6"
  }
}
